#!/bin/bash
#PBS -N probing_clustering_only
#PBS -q gpu_normal
#PBS -l select=1:model=mil_a100:ncpus=12:ngpus=4:mem=480G
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /nobackupp17/amunozja/git_repos/surya_workshop/logs/probing_clustering_only.log

# Clustering probes only: umap_cluster, cluster_purity, hidden_physical_spatial.
# Requires cuML (GPU-accelerated UMAP + HDBSCAN).
# Run this after run_probing_no_clustering.pbs has completed.

set -euo pipefail

REPO=/nobackupp17/amunozja/git_repos/surya_workshop
PYTHON=/nobackupnfs1/sroy14/rohit/envs/.a100_env/bin/python
ABLATION_DIR=/nobackupp17/amunozja/ablation_outputs_full
OUT_DIR=/nobackupp17/amunozja/unified_probing_full

cd "$REPO"

echo "======================================================"
echo "Job:        $PBS_JOBID"
echo "Node:       $(hostname)"
echo "Start:      $(date)"
echo "Ablation:   $ABLATION_DIR"
echo "Output:     $OUT_DIR"
echo "======================================================"

$PYTHON analysis/embeddings/unified_probing.py \
    --ablation-dir  "$ABLATION_DIR" \
    --out-dir       "$OUT_DIR" \
    --clustering-only \
    --hdbscan-min-cluster-size 200 \
    --hdbscan-min-samples 100 \
    --umap-n-points 500000 \
    --exclude-na-from-clustering \
    --seed 42

echo "======================================================"
echo "Done: $(date)"
echo "======================================================"
